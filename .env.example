PORT=5000
FRONTEND_URL=http://localhost:3000
# development | production (в production включаются secure-cookie и строгая проверка секретов)
NODE_ENV=development
# lax — если фронт и API на одном сайте; none — если на разных доменах (нужен HTTPS)
COOKIE_SAMESITE=lax

# --- База данных: один из двух вариантов ---
# 1) Облачный PostgreSQL (Neon и т.п.): одна строка подключения. Если она задана, DB_* ниже игнорируются.
#    Берётся в Neon: Connect -> Postgres database -> Connection string (пароль подставьте свой).
#    postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
#    необязательно: прямое (не pooler) подключение только для `npm run migrate`
DATABASE_URL_UNPOOLED=
# 2) Локальная база (используется, когда DATABASE_URL пуст)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai-operator
DB_USER=postgres
DB_PASSWORD=

# минимум 32 случайных символа:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google-callback

# Cloudinary — хранилище аватарок (обязательно в production: на Render локальный диск временный)
# Cloudinary Console -> Dashboard -> API Keys. Ключи храните только на сервере (Render -> Environment)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# необязательно: папка в Cloudinary (по умолчанию opero/avatars); удобно разделять prod и staging
CLOUDINARY_FOLDER=

GEMINI_API_KEY=
# необязательно: модель Gemini (по умолчанию gemini-3.6-flash)
GEMINI_MODEL=

# Optional — needed to actually send "forgot password" emails. Without these,
# the reset link is logged to the server console instead of emailed.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<your gmail>, SMTP_PASS=<App Password from
# https://myaccount.google.com/apppasswords, not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
